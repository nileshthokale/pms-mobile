# AI_API_KEY: API key for your chosen Vision AI provider (configure via the Secrets panel in AI Studio).
AI_API_KEY=YOUR_AI_API_KEY_HERE

# AI_API_ENDPOINT: Full REST endpoint URL for prescription image analysis.
# Examples:
# - OpenAI-compatible Vision: https://api.openai.com/v1/chat/completions
# - Custom/Self-hosted Vision API: https://your-api.example.com/v1/analyze
# - Google Generative Language REST: https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
AI_API_ENDPOINT=YOUR_AI_API_ENDPOINT_HERE

# AI_MODEL_NAME: Model identifier required by your provider (e.g. gpt-4o, claude-3-5-sonnet, gemini-3.5-flash).
AI_MODEL_NAME=YOUR_AI_MODEL_NAME_HERE

# AI_AUTH_METHOD: Authentication mechanism (BEARER_HEADER, X_API_KEY_HEADER, or QUERY_PARAM_KEY).
AI_AUTH_METHOD=BEARER_HEADER

# AI_REQUEST_FORMAT: Payload format (OPENAI_VISION, GEMINI_REST, or GENERIC_JSON_VISION).
AI_REQUEST_FORMAT=OPENAI_VISION

# DESKTOP_BRIDGE_API_TOKEN: Shared secret token for authenticating the Python/PySide6 Desktop Counter Sale connector.
DESKTOP_BRIDGE_API_TOKEN=YOUR_DESKTOP_BRIDGE_TOKEN_HERE
